{
  "name": "formalux",
  "version": "1.0.0",
  "description": "فورما لوكس - مصنع التحويل الفاخر للفيديو والصوت والصور والمستندات",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "author": "Mohammad Fahmi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammadfahmi2030/FormaLux.git"
  },
  "homepage": "https://github.com/mohammadfahmi2030/FormaLux",
  "type": "commonjs",
  "build": {
    "appId": "com.formalux.app",
    "productName": "FormaLux",
    "copyright": "Copyright © 2026 Mohammad Fahmi. All rights reserved.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "FormaLux by Mohammad Fahmi",
      "signtoolOptions": {
        "publisherName": "Mohammad Fahmi",
        "certificateFile": "build/MohammadFahmi.pfx",
        "certificatePassword": "FormaLux2026"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FormaLux",
      "include": "build/installer.nsh",
      "unicode": true,
      "language": "1025"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
